{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "waffle-sir",
  "main": "src/index.js",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/ws"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "waffle-sir-db",
      "database_id": "03930f77-22e9-4ffd-9b11-10f234496305",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "ORDER_ROOM", "class_name": "OrderRoom" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["OrderRoom"] }
  ],
  "vars": {
    "APP_NAME": "Waffle Sir"
  }
}
